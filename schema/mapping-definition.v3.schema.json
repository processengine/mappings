{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processengine.dev/schema/mapping-definition.v3.schema.json",
  "title": "ProcessEngine Mappings v3 Definition",
  "type": "object",
  "required": ["mappingId", "kind", "title", "description", "output"],
  "additionalProperties": false,
  "properties": {
    "mappingId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["payload", "facts", "result"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "output": { "type": "object", "minProperties": 1 },
    "metadata": { "type": "object" }
  }
}
